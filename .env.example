# ===== RADIO STATION STUDIO PRO — variáveis de ambiente (exemplo) =====
# NUNCA versione o arquivo .env real. Gere segredos com: ./scripts/gen_secrets.sh

# Domínios (DNS do tipo A apontando para a VPS)
APP_DOMAIN=radio.seudominio.com.br
STREAM_DOMAIN=stream.seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br
RSSP_PUBLIC_BASE_URL=https://radio.seudominio.com.br

# Segredos (gerados por scripts/gen_secrets.sh)
RSSP_SECRET_KEY=troque-por-64-caracteres-aleatorios
RSSP_ENCRYPTION_KEY=troque-por-chave-fernet-base64
POSTGRES_PASSWORD=troque
ICECAST_SOURCE_PASSWORD=troque
ICECAST_ADMIN_PASSWORD=troque

# Limites e ajustes
RSSP_MAX_UPLOAD_MB=300
RSSP_ACCESS_TOKEN_MINUTES=15
RSSP_REFRESH_TOKEN_DAYS=14
RSSP_LOGIN_RATE_PER_MINUTE=10
ICECAST_MAX_CLIENTS=500

# Armazenamento: local (volume Docker) ou s3 (requer boto3 e credenciais AWS_* padrão)
RSSP_STORAGE_BACKEND=local
# RSSP_S3_BUCKET=
# RSSP_S3_ENDPOINT=https://s3.sa-east-1.amazonaws.com
# RSSP_S3_REGION=sa-east-1
