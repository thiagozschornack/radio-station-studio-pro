[Unit]
Description=RADIO STATION STUDIO PRO — worker de análise de mídia
After=network-online.target postgresql.service icecast2.service
Wants=network-online.target

[Service]
User=rssp
WorkingDirectory=/opt/rssp/backend
EnvironmentFile=/etc/rssp/rssp.env
Environment=PYTHONPATH=/opt/rssp/backend RSSP_WEB_DIR=/opt/rssp/web
ExecStart=/opt/rssp/venv/bin/python -m rssp.jobs
Restart=always
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rssp
PrivateTmp=true

[Install]
WantedBy=multi-user.target
